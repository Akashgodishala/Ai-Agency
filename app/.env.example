# Copy this file to .env.local and fill in your key to switch AgentMint from
# the demo engine to live AI. Get a key at https://console.anthropic.com
# NEVER commit .env.local — it's gitignored.

ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-sonnet-5)
# AGENTMINT_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Future rungs (see docs/08-integrations-blueprint.md). These stay empty until
# their build phase arrives — do not collect keys early.
# ---------------------------------------------------------------------------

# Rung 2 — accounts + publish (database)
# DATABASE_URL=

# Rung 3 — subscriptions (Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Rung 4 — texts & payment links (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Rung 5 — voice agents (VAPI)
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=
# deploy trigger july 30
